{
  "experiment": "bb04-fc",
  "description": "票 04 的 FC-A…FC-E 控制变量矩阵：FC(1,64,64) int8 常量权重为原点，每次只动一个维度（N / K / 权重内容 / 量化配置 / 精度档）。加变体只加一行 variants，加判定只加一行 checks；v1 新增两个只影响建模的可选字段 model.dtype / model.quant（见 report §1.3）。 v2（06 起）：新增 default_noise_scope/noise_scopes（每变体各自标定噪声，union 只留作对照）、pack（.dlb 压缩等级）、prewrite（给 --dla-metadata 喂 key:file）；新增 fc_f_gno_* / fc_g_meta / fc_h_resize 六个变体与 stable_diff / flag_payload / pack_size 三类判定。",
  "repeats": 5,
  "class_slack": 4,
  "class_threshold_share": 0.15,
  "zones": {
    "weight": {
      "from": "fc_a",
      "to": "fc_d_w_cal",
      "note": "FC-D：只换权重（同形状、同 bias、同输入码）的离噪差分区，按 <=64 B 小间隙合并 = 权重区标定；判定用的是另一对权重（fc_d_w_swap）",
      "gap": 64
    }
  },
  "variants": [
    {
      "id": "fc_a",
      "note": "FC-A 基准 FC(1,64,64) int8 常量权重（与票 01/02/03 同一份夹具、同一量化档）",
      "model": {
        "op": "fc",
        "m": 1,
        "k": 64,
        "n": 64,
        "dtype": "int8"
      },
      "pack": {
        "levels": [
          0,
          9
        ]
      }
    },
    {
      "id": "fc_b_n128",
      "note": "FC-B 只改 N：1,64,64 -> 1,64,128（K/M 不动）",
      "model": {
        "op": "fc",
        "m": 1,
        "k": 64,
        "n": 128,
        "dtype": "int8"
      }
    },
    {
      "id": "fc_c_k128",
      "note": "FC-C 只改 K：1,64,64 -> 1,128,64（M/N 不动）",
      "model": {
        "op": "fc",
        "m": 1,
        "k": 128,
        "n": 64,
        "dtype": "int8"
      }
    },
    {
      "id": "fc_d_w_cal",
      "note": "FC-D 只换权重（rng seed 41）：权重区标定用",
      "model": {
        "op": "fc",
        "m": 1,
        "k": 64,
        "n": 64,
        "dtype": "int8",
        "weights": {
          "kind": "rng",
          "seed": 41
        }
      }
    },
    {
      "id": "fc_d_w_swap",
      "note": "FC-D 只换权重（rng seed 42）：与标定不是同一对，用来验 zone 收敛",
      "model": {
        "op": "fc",
        "m": 1,
        "k": 64,
        "n": 64,
        "dtype": "int8",
        "weights": {
          "kind": "rng",
          "seed": 42
        }
      }
    },
    {
      "id": "fc_e_out16",
      "note": "FC-E1 只改声明 output scale：requant 倍率 1/32 -> 1/16（码值逐字节不变）",
      "model": {
        "op": "fc",
        "m": 1,
        "k": 64,
        "n": 64,
        "dtype": "int8",
        "quant": {
          "output": 0.0009920019840039679
        }
      }
    },
    {
      "id": "fc_e_abs2",
      "note": "FC-E2 只改声明 scale 的绝对值：input/weights 各 x2（bias x4、output x4），requant 倍率仍是 1/32，码值不变",
      "model": {
        "op": "fc",
        "m": 1,
        "k": 64,
        "n": 64,
        "dtype": "int8",
        "quant": {
          "input": 0.015748031496062992,
          "weights": 0.015748031496062992
        }
      }
    },
    {
      "id": "fc_e_out8",
      "note": "FC-E1b 只改声明 output scale：requant 倍率 1/32 -> 1/8（码值不变；E1 的第二个点，用来判 6343 那个字节是不是随倍率线性走）",
      "model": {
        "op": "fc",
        "m": 1,
        "k": 64,
        "n": 64,
        "dtype": "int8",
        "quant": {
          "output": 0.0004960009920019839
        }
      }
    },
    {
      "id": "fc_e_fp16",
      "note": "FC-E3 形状/权重源数据不变，精度档 int8 -> fp16",
      "model": {
        "op": "fc",
        "m": 1,
        "k": 64,
        "n": 64,
        "dtype": "fp16"
      }
    },
    {
      "id": "fc_f_gno_ndf",
      "note": "只加 --gno NDF（graphite neuron optimization；dump 文本与产物大小都不该变，只多出命令行的 10 B 回显）",
      "model": {
        "op": "fc",
        "m": 1,
        "k": 64,
        "n": 64,
        "dtype": "int8"
      },
      "flags": [
        "--gno",
        "NDF"
      ]
    },
    {
      "id": "fc_f_gno_smp",
      "note": "只加 --gno SMP",
      "model": {
        "op": "fc",
        "m": 1,
        "k": 64,
        "n": 64,
        "dtype": "int8"
      },
      "flags": [
        "--gno",
        "SMP"
      ]
    },
    {
      "id": "fc_f_gno_bmp",
      "note": "只加 --gno BMP",
      "model": {
        "op": "fc",
        "m": 1,
        "k": 64,
        "n": 64,
        "dtype": "int8"
      },
      "flags": [
        "--gno",
        "BMP"
      ]
    },
    {
      "id": "fc_f_gno_all",
      "note": "只加 --gno NDF,SMP,BMP（三个一起开）",
      "model": {
        "op": "fc",
        "m": 1,
        "k": 64,
        "n": 64,
        "dtype": "int8"
      },
      "flags": [
        "--gno",
        "NDF,SMP,BMP"
      ]
    },
    {
      "id": "fc_g_meta",
      "note": "只加 --dla-metadata note:<file>：外部元数据是唯一「名字里就写着要写进产物」的开关，用它验 flag_payload 判据不是恒绿",
      "model": {
        "op": "fc",
        "m": 1,
        "k": 64,
        "n": 64,
        "dtype": "int8"
      },
      "flags": [
        "--dla-metadata",
        "note:{build}/note.txt"
      ],
      "prewrite": {
        "note.txt": "bb06 metadata note\n"
      }
    },
    {
      "id": "fc_h_resize",
      "note": "只加 --resize 2x64（编译期换输入形状，02 票已验行为；这里量它进不进产物）",
      "model": {
        "op": "fc",
        "m": 1,
        "k": 64,
        "n": 64,
        "dtype": "int8"
      },
      "flags": [
        "--resize",
        "2x64"
      ]
    }
  ],
  "checks": [
    {
      "id": "case-b-n-changed",
      "kind": "diff_outside_noise",
      "a": "fc_a",
      "b": "fc_b_n128",
      "min_bytes": 1024,
      "min_fraction": 0.01,
      "max_noise_share": 0.1,
      "note": "FC-B 只改 N：差分必须存在，且不能被噪声解释（噪声内占比 <= 10%）"
    },
    {
      "id": "case-b-size-grows",
      "kind": "size_delta",
      "a": "fc_b_n128",
      "b": "fc_a",
      "lo": 0.5,
      "hi": 1.5,
      "note": "FC-B 产物增长必须与权重字节同量级（N 翻倍 -> 权重 +4096 B、bias +256 B）。工具的 size_delta 既有约定是 delta = size_a - size_b，所以增长把大的一侧写在 a"
    },
    {
      "id": "case-c-k-changed",
      "kind": "diff_outside_noise",
      "a": "fc_a",
      "b": "fc_c_k128",
      "min_bytes": 1024,
      "min_fraction": 0.01,
      "max_noise_share": 0.1,
      "note": "FC-C 只改 K：差分必须存在，且不能被噪声解释"
    },
    {
      "id": "case-c-size-grows",
      "kind": "size_delta",
      "a": "fc_c_k128",
      "b": "fc_a",
      "lo": 0.5,
      "hi": 1.5,
      "note": "FC-C 产物增长必须与权重字节同量级（K 翻倍 -> 权重 +4096 B、bias 不变）。delta = size_a - size_b（工具既有约定）"
    },
    {
      "id": "case-d-weights-confined",
      "kind": "diff_within_zone",
      "a": "fc_a",
      "b": "fc_d_w_swap",
      "zone": "weight",
      "allow_outside_bytes": 64,
      "note": "FC-D 只换权重：变化必须落在权重区内（zone 由另一对权重标定；余量 64 B = 压缩流/边界抖动）"
    },
    {
      "id": "case-e1-out-scale-changed",
      "kind": "diff_outside_noise",
      "a": "fc_a",
      "b": "fc_e_out16",
      "min_bytes": 8,
      "min_fraction": 0,
      "max_noise_share": 0.9,
      "note": "FC-E1 只改 requant 倍率 1/32->1/16：量化参数进了产物 => 必须有离噪变化；不改大小"
    },
    {
      "id": "case-e1-quant-enters-artifact",
      "kind": "diff_outside_noise",
      "a": "fc_a",
      "b": "fc_e_out16",
      "min_bytes": 1,
      "min_fraction": 0,
      "max_noise_share": 0.9,
      "note": "事后追加（阈值 1 B，只问「有没有」不问量级）：原 case-e1 的 min_bytes=8 是写矩阵时随手取的，实测离噪只 1 B —— 原条目按预注册保留为 FAIL，这条单独记录「量化参数确实进了产物」"
    },
    {
      "id": "case-e2-abs-scale-changed",
      "kind": "diff_outside_noise",
      "a": "fc_a",
      "b": "fc_e_abs2",
      "min_bytes": 8,
      "min_fraction": 0,
      "max_noise_share": 0.9,
      "note": "FC-E2 只改声明 scale 的绝对值（比值不变）：如果产物只吃比值 => 这条应为 FAIL；预注册为「绝对 scale 也进产物」"
    },
    {
      "id": "case-e1b-out8-changed",
      "kind": "diff_outside_noise",
      "a": "fc_a",
      "b": "fc_e_out8",
      "min_bytes": 1,
      "min_fraction": 0,
      "max_noise_share": 0.9,
      "note": "FC-E1b 倍率 1/32->1/8：与 E1 同一问法（有没有离噪变化），给 6343 那个字节补第二个点"
    },
    {
      "id": "case-e3-fp16-differs",
      "kind": "diff_outside_noise",
      "a": "fc_a",
      "b": "fc_e_fp16",
      "min_bytes": 1024,
      "min_fraction": 0.01,
      "max_noise_share": 0.1,
      "note": "FC-E3 int8->fp16：整份产物结构必须变（权重字节也从 4096 变 8192）"
    },
    {
      "id": "case-repeat-b",
      "kind": "repeatable",
      "variant": "fc_b_n128",
      "holdout_run": 5,
      "allow_outside_bytes": 8,
      "note": "FC-B 第 5 次（holdout，不参与噪声标定）必须与第 1 次除噪声区外逐字节相同"
    },
    {
      "id": "case-repeat-c",
      "kind": "repeatable",
      "variant": "fc_c_k128",
      "holdout_run": 5,
      "allow_outside_bytes": 8,
      "note": "FC-C holdout 可复现性"
    },
    {
      "id": "case-repeat-e1b",
      "kind": "repeatable",
      "variant": "fc_e_out8",
      "holdout_run": 5,
      "allow_outside_bytes": 8,
      "note": "FC-E1b holdout 可复现性"
    },
    {
      "id": "case-repeat-e1",
      "kind": "repeatable",
      "variant": "fc_e_out16",
      "holdout_run": 5,
      "allow_outside_bytes": 8,
      "note": "FC-E1 holdout 可复现性"
    },
    {
      "id": "case-repeat-e2",
      "kind": "repeatable",
      "variant": "fc_e_abs2",
      "holdout_run": 5,
      "allow_outside_bytes": 8,
      "note": "FC-E2 holdout 可复现性"
    },
    {
      "id": "case-repeat-e3",
      "kind": "repeatable",
      "variant": "fc_e_fp16",
      "holdout_run": 5,
      "allow_outside_bytes": 8,
      "note": "FC-E3 holdout 可复现性"
    },
    {
      "id": "noise-budget",
      "kind": "noise_budget",
      "max_share": 0.05,
      "note": "噪声区本身不得超过产物的 5%（否则「除噪声区外相同」没有信息量）"
    },
    {
      "id": "control-same-input-no-change",
      "kind": "diff_outside_noise",
      "a": "fc_a",
      "b": "fc_a",
      "min_bytes": 1,
      "expect": "fail",
      "note": "对照：同一份产物不该报变化 —— 必须被判 FAIL，证明判定不是恒真"
    },
    {
      "id": "control-shape-escapes-weight-zone",
      "kind": "diff_within_zone",
      "a": "fc_a",
      "b": "fc_b_n128",
      "zone": "weight",
      "expect": "fail",
      "note": "对照：改 N 的变化不可能全在权重区 —— 必须被判 FAIL"
    },
    {
      "id": "control-quant-escapes-weight-zone",
      "kind": "diff_within_zone",
      "a": "fc_a",
      "b": "fc_e_fp16",
      "zone": "weight",
      "expect": "fail",
      "note": "对照：换精度档的变化不可能全在权重区 —— 必须被判 FAIL"
    },
    {
      "id": "case-e1-stable-byte",
      "kind": "stable_diff",
      "a": "fc_a",
      "b": "fc_e_out16",
      "min_bytes": 1,
      "expect_offsets": [
        6343
      ],
      "note": "稳定字节口径：只改 requant 倍率 1/32->1/16，真信号必须恰好是偏移 6343 那一个字节（04 §4.2 的 1 B，本工具现在能独立复现）"
    },
    {
      "id": "case-e1b-stable-byte",
      "kind": "stable_diff",
      "a": "fc_a",
      "b": "fc_e_out8",
      "min_bytes": 1,
      "expect_offsets": [
        6343
      ],
      "note": "同上，倍率 1/32->1/8：仍只有 6343 一个字节"
    },
    {
      "id": "case-e2-stable-none",
      "kind": "stable_diff",
      "a": "fc_a",
      "b": "fc_e_abs2",
      "min_bytes": 0,
      "max_bytes": 0,
      "note": "声明 scale 绝对值 ×2（比值不变）：稳定字节口径下必须是 0 B（H6 的独立复核）"
    },
    {
      "id": "case-d-stable-weight-block",
      "kind": "stable_diff",
      "a": "fc_a",
      "b": "fc_d_w_swap",
      "min_bytes": 4000,
      "max_bytes": 4300,
      "note": "只换权重：稳定字节口径下信号必须仍是权重块量级（4096 B 上下），且被 split_reorder 标出的整块重排不计入"
    },
    {
      "id": "case-f-gno-no-payload",
      "kind": "flag_payload",
      "a": "fc_a",
      "b": "fc_f_gno_ndf",
      "expected_extra_bytes": 10,
      "allow_payload_bytes": 0,
      "note": "--gno NDF：产物内容零变化，+10 B 全是命令行回显（len('--gno NDF')+2 个空格）"
    },
    {
      "id": "case-f-gno-all-no-payload",
      "kind": "flag_payload",
      "a": "fc_a",
      "b": "fc_f_gno_all",
      "expected_extra_bytes": 18,
      "allow_payload_bytes": 0,
      "note": "--gno NDF,SMP,BMP：产物内容零变化，+18 B 全是命令行回显"
    },
    {
      "id": "case-g-meta-payload",
      "kind": "flag_payload",
      "a": "fc_a",
      "b": "fc_g_meta",
      "allow_payload_bytes": 0,
      "expect": "fail",
      "note": "--dla-metadata：名字就写着要写进产物 => 内容必须变（这条按预期被判 FAIL，用来证明 flag_payload 不是恒绿）"
    },
    {
      "id": "case-h-resize-changes-artifact",
      "kind": "flag_payload",
      "a": "fc_a",
      "b": "fc_h_resize",
      "allow_payload_bytes": 0,
      "expect": "fail",
      "note": "--resize 2x64：改的是输入形状 => 产物内容必须变（同样按预期被判 FAIL）"
    },
    {
      "id": "case-p-dlb-levels",
      "kind": "pack_size",
      "variant": "fc_a",
      "level_low": 0,
      "level_high": 9,
      "max_ratio": 0.85,
      "note": ".dlb 压缩等级：level 9 必须明显小于 level 0（容器层变量，不进 .dla 差分）"
    }
  ],
  "default_noise_scope": "per-variant",
  "noise_scopes": [
    "union",
    "per-variant"
  ]
}
